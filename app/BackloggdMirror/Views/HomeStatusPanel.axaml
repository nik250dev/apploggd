<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BackloggdMirror.ViewModels"
             xmlns:ctl="using:BackloggdMirror.Views.Controls"
             xmlns:services="using:BackloggdMirror.Services"
             x:Class="BackloggdMirror.Views.HomeStatusPanel"
             x:DataType="vm:SessionSlotViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Views/Controls/DetectionSwitch.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <StreamGeometry x:Key="PauseIconData">M6,5H10V19H6ZM14,5H18V19H14Z</StreamGeometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Cross-fades between the waiting and paused versions of an element. -->
        <Style Selector=":is(Control).fade">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.26"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector=":is(Control).fade.shown">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Panel#Artwork">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.0" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel#Artwork.shown">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Status disc: brand while detecting, neutral while paused. -->
        <Style Selector="Ellipse#StatusDisc">
            <Setter Property="Fill" Value="{DynamicResource SurfaceBrandHoverBrush}"/>
            <Setter Property="Stroke" Value="#8CEA377A"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                    <BrushTransition Property="Stroke" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse#StatusDisc.paused">
            <Setter Property="Fill" Value="{DynamicResource InputHoverBackgroundBrush}"/>
            <Setter Property="Stroke" Value="{DynamicResource SidebarBorderBrush}"/>
        </Style>

        <!-- Sizes as styles, not attributes: a local value would win over the compact half's. -->
        <Style Selector="StackPanel#IdleStack">
            <Setter Property="Spacing" Value="18"/>
        </Style>
        <Style Selector="Panel#DiscHost">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="80"/>
        </Style>
        <Style Selector="TextBlock.state-text">
            <Setter Property="FontSize" Value="26"/>
        </Style>
        <Style Selector="StackPanel#PlayingStack">
            <Setter Property="Margin" Value="40,0"/>
        </Style>
        <Style Selector="TextBlock#GameTitle">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style Selector="TextBlock#PlayTimeText">
            <Setter Property="FontSize" Value="52"/>
        </Style>
        <Style Selector="StackPanel#BlacklistRow">
            <Setter Property="Margin" Value="0,0,22,16"/>
        </Style>
        <Style Selector="StackPanel#BlacklistRow TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Half of the Home, with the dual detection on: about 530x285. -->
        <Style Selector="Panel.compact StackPanel#IdleStack">
            <Setter Property="Spacing" Value="14"/>
        </Style>
        <Style Selector="Panel.compact Panel#DiscHost">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="72"/>
        </Style>
        <Style Selector="Panel.compact TextBlock.state-text">
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style Selector="Panel.compact StackPanel#PlayingStack">
            <Setter Property="Margin" Value="28,0"/>
        </Style>
        <Style Selector="Panel.compact TextBlock#GameTitle">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="MaxLines" Value="2"/>
        </Style>
        <Style Selector="Panel.compact TextBlock#PlayTimeText">
            <Setter Property="FontSize" Value="42"/>
        </Style>
        <Style Selector="Panel.compact StackPanel#BlacklistRow">
            <Setter Property="Margin" Value="0,0,18,14"/>
        </Style>
        <Style Selector="Panel.compact StackPanel#BlacklistRow TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Idle animations, stopped with the window's "animate" class like the rest. -->
        <Style Selector="Window.animate :is(ctl|LoopingAnimationControl)">
            <Setter Property="IsAnimationEnabled" Value="True"/>
        </Style>
    </UserControl.Styles>

    <Panel Classes.compact="{Binding IsCompact}">
        <Border CornerRadius="20" ClipToBounds="True" Background="{DynamicResource PanelBackgroundBrush}">
            <Panel>
                <Panel x:Name="Artwork" Classes.shown="{Binding IsBackgroundImageVisible}">
                    <Image Source="{Binding GameBackgroundImage}" Stretch="UniformToFill" Opacity="0.1"/>
                </Panel>

                <ctl:BreathingGlow Color="{DynamicResource BrandPrimaryColor}"
                                   IsActive="{Binding IsWaitingAnimationVisible}"/>

                <!-- Waiting / paused -->
                <StackPanel x:Name="IdleStack" IsVisible="{Binding !IsGameRunning}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Panel x:Name="DiscHost" HorizontalAlignment="Center">
                        <ctl:ListeningRing Color="{DynamicResource BrandPrimaryColor}"
                                           IsActive="{Binding IsWaitingAnimationVisible}"/>
                        <Ellipse x:Name="StatusDisc" StrokeThickness="1.5" Classes.paused="{Binding IsGameDetectionHeld}"/>
                        <ctl:SpinnerRing Color="White"
                                         IsActive="{Binding IsAutoSaveSpinnerVisible}"/>
                        <PathIcon Classes="fade" Classes.shown="{Binding IsGameDetectionActive}"
                                  Data="{DynamicResource GamepadIconData}" Width="38" Height="38"
                                  Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        <PathIcon Classes="fade" Classes.shown="{Binding IsGameDetectionHeld}"
                                  Data="{StaticResource PauseIconData}" Width="24" Height="24"
                                  Foreground="{DynamicResource IconMediumBrush}"/>
                    </Panel>

                    <Panel Height="34" HorizontalAlignment="Center">
                        <TextBlock Classes="fade state-text" Classes.shown="{Binding IsGameDetectionActive}"
                                   Text="{Binding [Home_WaitingForGame], Source={x:Static services:LocalizationService.Instance}}"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Classes="fade state-text" Classes.shown="{Binding IsDetectionPausedTextVisible}"
                                   Text="{Binding [Home_SearchPaused], Source={x:Static services:LocalizationService.Instance}}"
                                   FontWeight="Bold" Foreground="{DynamicResource IconLightBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Classes="fade state-text" Classes.shown="{Binding IsAutoSavingSession}"
                                   Text="{Binding [Home_SavingSession], Source={x:Static services:LocalizationService.Instance}}"
                                   FontWeight="Bold" Foreground="{DynamicResource IconLightBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>

                    <ctl:DetectionSwitch HorizontalAlignment="Center"
                                         IsChecked="{Binding IsGameDetectionActive, Mode=OneWay}"
                                         IsEnabled="{Binding IsDetectionSwitchEnabled}"
                                         Command="{Binding ToggleGameDetectionCommand}"
                                         OnLabel="{Binding [Home_DetectionOn], Source={x:Static services:LocalizationService.Instance}}"
                                         OffLabel="{Binding [Home_DetectionOff], Source={x:Static services:LocalizationService.Instance}}"
                                         AutomationProperties.Name="{Binding [Home_DetectionSwitch], Source={x:Static services:LocalizationService.Instance}}"/>
                </StackPanel>

                <!-- Playing -->
                <StackPanel x:Name="PlayingStack" IsVisible="{Binding IsGameRunning}" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Home_PlayingNow], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="14" FontWeight="SemiBold" LetterSpacing="0.5"
                               Foreground="{DynamicResource BrandPrimaryLightBrush}" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" Opacity="1.0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="GameTitle" Text="{Binding GameName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="1.0" OffsetX="0" OffsetY="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="PlayTimeText" Text="{Binding PlayTime}" FontWeight="SemiBold" FontFeatures="+tnum"
                               Foreground="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#EA377A" BlurRadius="20" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="BlacklistRow" IsVisible="{Binding IsGameRunning}" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <StackPanel.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" Opacity="1.0"/>
                    </StackPanel.Effect>
                    <TextBlock Text="{Binding [Blacklist_NotAGame], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding !IsRunningGameEmulated}"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding [Blacklist_NotWanted], Source={x:Static services:LocalizationService.Instance}}" IsVisible="{Binding IsRunningGameEmulated}"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Button Classes="link" Command="{Binding BlacklistRunningGameCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C10.1,4 8.4,4.6 7.1,5.7L18.3,16.9C19.3,15.5 20,13.8 20,12C20,7.6 16.4,4 12,4M16.9,18.3L5.7,7.1C4.6,8.4 4,10.1 4,12C4,16.4 7.6,20 12,20C13.9,20 15.6,19.4 16.9,18.3Z"
                                      Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [Blacklist_Add], Source={x:Static services:LocalizationService.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Panel>
        </Border>

        <ctl:AmbientEdge CornerRadius="20" StrokeThickness="2"
                         Color="{DynamicResource BrandPrimaryColor}"
                         IsActive="{Binding IsWaitingAnimationVisible}"/>
    </Panel>
</UserControl>
