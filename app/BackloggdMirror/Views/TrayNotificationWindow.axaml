<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:BackloggdMirror.Services"
        x:Class="BackloggdMirror.Views.TrayNotificationWindow"
        Title="Notification"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Width="350" Height="70"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.visible">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Action button for the notices that carry one. Brand-filled but compact, so it reads as
             the one thing to click without shouting over a passive notice. -->
        <Style Selector="Button.tray-action">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Foreground repeated per state: the Fluent theme overwrites it on the ContentPresenter. -->
        <Style Selector="Button.tray-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tray-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource SidebarBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="10"
            BoxShadow="0 4 15 0 #40000000">
        <Border CornerRadius="10" ClipToBounds="True">
            <Grid RowDefinitions="*, Auto, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                    <PathIcon Grid.Column="0" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                              Width="24" Height="24"
                              Foreground="{DynamicResource IconMediumBrush}"
                              Margin="15,0,10,0" VerticalAlignment="Center"/>

                    <TextBlock x:Name="MessageText"
                               Grid.Column="1"
                               Text="{Binding [Tray_BackgroundRunning], Source={x:Static services:LocalizationService.Instance}}"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <Button Grid.Column="2" Click="CloseButton_Click"
                            Background="Transparent" BorderThickness="0" Padding="5"
                            Margin="0,5,5,0" VerticalAlignment="Top" Cursor="Hand">
                        <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Width="10" Height="10" Foreground="{DynamicResource IconDarkBrush}"/>
                    </Button>
                </Grid>

                <!-- Optional action. Indented to the message, not the icon. -->
                <Button x:Name="ActionButton" Grid.Row="1" Classes="tray-action"
                        IsVisible="False" Click="ActionButton_Click"
                        HorizontalAlignment="Left" Margin="49,8,15,14"/>

                <ProgressBar x:Name="NotificationProgress" Grid.Row="2" Minimum="0" Maximum="100" Value="100"
                             Height="3"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource IconMediumBrush}"
                             VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
    </Border>
</Window>
